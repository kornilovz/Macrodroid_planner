r":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"Вставьте расписание","m_stringValue":"","m_type":2,"supportsInput":false,"supportsOutput":true},"disableLogging":false,"m_SIGUID":-3516804541117948040,"m_classType":"SetVariableAction","m_comment":"Автоматически берёт целиком полученный текст из буфера обмена. Перед импортом нужно скопировать сообщение с расписанием.","m_constraintList":[{"checkCase":false,"dictionaryKeys":{"keys":[]},"dictionaryType":1,"enableRegex":false,"m_booleanValue":false,"m_doubleValue":0.0,"m_intCompareVariable":false,"m_intGreaterThan":false,"m_intLessThan":false,"m_intNotEqual":false,"m_intValue":4,"m_stringComparisonType":0,"m_stringEqual":true,"m_stringValue":"","m_variable":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"menu_index","m_stringValue":"","m_type":1,"supportsInput":true,"supportsOutput":true},"disableLogging":false,"m_SIGUID":-3476132410513204440,"m_classType":"MacroDroidVariableConstraint","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_nonRoot":true,"m_script":"src=$(cat <<'MD_IMPORT_TEXT'\n{lv=Вставьте расписание}\nMD_IMPORT_TEXT\n)\nsrc=$(printf '%s' \"$src\" | tr -d '\\r')\n\n# Предпочтительный формат: переносимый UTC-блок из «Поделиться расписанием».\nif printf '%s\\n' \"$src\" | grep -q '^MDUTC-BEGIN$'; then\n    payload=$(printf '%s\\n' \"$src\" | awk '/^MDUTC-BEGIN$/{p=1;next}/^MDUTC-END$/{p=0;exit}p')\nelse\n    # Совместимость со старой отправкой без служебного блока — только если\n    # явно указано «Расписание (UTC)». Местное время без UTC-блока намеренно\n    # не импортируем, чтобы не сдвинуть события в другом часовом поясе.\n    if printf '%s\\n' \"$src\" | grep -q '^Расписание (UTC)$'; then\n        payload=$(printf '%s\\n' \"$src\" | sed -n -E \\\n          -e 's/^Пн[[:space:]]+([0-9]{2}:[0-9]{2})[[:space:]]*\\|[[:space:]]*(.+)$/1 \\1|\\2/p' \\\n          -e 's/^Вт[[:space:]]+([0-9]{2}:[0-9]{2})[[:space:]]*\\|[[:space:]]*(.+)$/2 \\1|\\2/p' \\\n          -e 's/^Ср[[:space:]]+([0-9]{2}:[0-9]{2})[[:space:]]*\\|[[:space:]]*(.+)$/3 \\1|\\2/p' \\\n          -e 's/^Чт[[:space:]]+([0-9]{2}:[0-9]{2})[[:space:]]*\\|[[:space:]]*(.+)$/4 \\1|\\2/p' \\\n          -e 's/^Пт[[:space:]]+([0-9]{2}:[0-9]{2})[[:space:]]*\\|[[:space:]]*(.+)$/5 \\1|\\2/p' \\\n          -e 's/^Сб[[:space:]]+([0-9]{2}:[0-9]{2})[[:space:]]*\\|[[:space:]]*(.+)$/6 \\1|\\2/p' \\\n          -e 's/^Вс[[:space:]]+([0-9]{2}:[0-9]{2})[[:space:]]*\\|[[:space:]]*(.+)$/7 \\1|\\2/p')\n    else\n        printf 'INVALID'\n        exit\n    fi\nfi\n\n# Пустой служебный блок — валидное пустое расписание.\nif [ -z \"$payload\" ]; then\n    printf '__EMPTY__'\n    exit\nfi\n\nok=1\nclean=''\nwhile IFS= read -r line; do\n    [ -z \"$line\" ] && continue\n    # На всякий случай убираем служебный префикс :|, если он попал в строку при переносе.\n    line=$(printf '%s' \"$line\" | sed 's/^:|//')\n    if ! printf '%s' \"$line\" | grep -Eq '^[1-7] [0-9]{2}:[0-9]{2}\\|.+$'; then\n        ok=0; break\n    fi\n    left=${line%%|*}\n    event=${line#*|}\n    d=${left%% *}\n    t=${left#* }\n    h=${t%:*}; mi=${t#*:}\n    h10=${h#0}; mi10=${mi#0}\n    [ -z \"$h10\" ] && h10=0\n    [ -z \"$mi10\" ] && mi10=0\n    if [ \"$h10\" -gt 23 ] 2>/dev/null || [ \"$mi10\" -gt 59 ] 2>/dev/null || [ -z \"$event\" ]; then\n        ok=0; break\n    fi\n    clean=$(printf '%s\\n%s' \"$clean\" \"$d $h:$mi|$event\")\ndone <<MD_PAYLOAD\n$payload\nMD_PAYLOAD\n\nif [ \"$ok\" -ne 1 ]; then\n    printf 'INVALID'\n    exit\nfi\n\nprintf '%s\\n' \"$clean\" | sed '/^$/d' | LC_ALL=C sort | awk 'BEGIN{first=1} {if (!first) printf \"__MDSEP_93A7__\"; printf \"%s\", $0; first=0}'\n","m_variableToSaveResponse":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"import_clean_text","m_stringValue":"","m_type":2,"supportsInput":false,"supportsOutput":true},"timeoutSeconds":5,"useHelper":false,"useShizuku":false,"disableLogging":false,"m_SIGUID":7826446427546603697,"m_classType":"ShellScriptAction","m_comment":"Извлекает и проверяет UTC-блок. Возвращает записи одной строкой через __MDSEP_93A7__, чтобы MacroDroid не добавлял служебный :| к каждой строке shell-вывода.","m_constraintList":[{"checkCase":false,"dictionaryKeys":{"keys":[]},"dictionaryType":1,"enableRegex":false,"m_booleanValue":false,"m_doubleValue":0.0,"m_intCompareVariable":false,"m_intGreaterThan":false,"m_intLessThan":false,"m_intNotEqual":false,"m_intValue":4,"m_stringComparisonType":0,"m_stringEqual":true,"m_stringValue":"","m_variable":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"menu_index","m_stringValue":"","m_type":1,"supportsInput":true,"supportsOutput":true},"disableLogging":false,"m_SIGUID":-5475257475955788038,"m_classType":"MacroDroidVariableConstraint","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_isDisabled":false,"m_isOrCondition":false},{"cancelPrevious":false,"m_backgroundColor":-14606047,"m_displayIcon":false,"m_duration":0,"m_horizontalPosition":0,"m_imageName":"launcher_no_border","m_imagePackageName":"com.arlosoft.macrodroid","m_imageResourceName":"launcher_no_border","m_messageText":"Не удалось импортировать: вставьте текст из «Поделиться расписанием»","m_position":0,"m_textColor":-1,"m_tintIcon":false,"maintainSpaces":false,"textAlignment":0,"useTextOnly":true,"disableLogging":false,"m_SIGUID":-4429041092905241979,"m_classType":"ToastAction","m_comment":"