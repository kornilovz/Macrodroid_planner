ictionary"},"isActionBlockWorkingVar":true,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":1.0,"m_intValue":1,"m_name":"is_current","m_stringValue":"","m_type":1,"supportsInput":false,"supportsOutput":true}],"localVarsAlphabetical":true,"loggingLevel":0,"m_GUID":-5097293009981501689,"m_actionList":[{"booleanDictionaryKeys":{"keys":[]},"dictionaryKeys":[],"dictionaryOrArrayType":-1,"existingManualKeyType":0,"m_booleanInvert":false,"m_darkMode":-1,"m_doubleRandomMax":0.0,"m_doubleRandomMin":0.0,"m_expression":"{v=Версия расписания}","m_falseLabel":"Ложь","m_intExpression":true,"m_intRandom":false,"m_intRandomMax":0,"m_intRandomMin":0,"m_intValueDecrement":false,"m_intValueIncrement":false,"m_newBooleanValue":false,"m_newDoubleValue":0.0,"m_newIntValue":0,"m_trueLabel":"Истина","m_userPrompt":false,"m_userPromptEmptyAtStart":false,"m_userPromptPassword":false,"m_userPromptPasswordToggle":false,"m_userPromptShowCancel":true,"m_userPromptStopAfterCancel":true,"m_variable":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":true,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"version_at_start","m_stringValue":"","m_type":1,"supportsInput":false,"supportsOutput":true},"disableLogging":false,"m_SIGUID":-8844538287166782093,"m_classType":"SetVariableAction","m_comment":"Запоминает версию расписания, для которой рассчитано ожидание.","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_nonRoot":true,"m_script":"schedule_json=$(cat <<'MD_SCHEDULE_JSON'\n{vjson=Расписание}\nMD_SCHEDULE_JSON\n)\n\n# Текущее UTC-время считаем только из Unix epoch.\n# Заодно epoch используем для абсолютного времени ближайшего события.\nepoch=$(date +%s)\ndays=$((epoch / 86400))\nsec_day=$((epoch % 86400))\nnow_day=$(( (days + 3) % 7 + 1 ))\nnow=$(( (now_day - 1) * 86400 + sec_day ))\n\nbest=604801\nbest_event=''\n\n# Из JSON берём только значения расписания вида D HH:MM|Событие.\nitems=$(printf '%s' \"$schedule_json\" | grep -oE '\"[1-7] [0-2][0-9]:[0-5][0-9]\\|[^\\\"]+\"' | sed 's/^\"//;s/\"$//')\n\nwhile IFS= read -r item; do\n    [ -z \"$item\" ] && continue\n\n    day=$(printf '%s' \"$item\" | cut -d' ' -f1)\n    time_and_event=$(printf '%s' \"$item\" | cut -d' ' -f2-)\n    time=$(printf '%s' \"$time_and_event\" | cut -d'|' -f1)\n    event=$(printf '%s' \"$time_and_event\" | cut -d'|' -f2-)\n\n    hour=$(printf '%s' \"$time\" | cut -d':' -f1)\n    minute=$(printf '%s' \"$time\" | cut -d':' -f2)\n    hour=${hour#0}; minute=${minute#0}\n    [ -z \"$hour\" ] && hour=0\n    [ -z \"$minute\" ] && minute=0\n\n    [ \"$day\" -lt 1 ] 2>/dev/null && continue\n    [ \"$day\" -gt 7 ] 2>/dev/null && continue\n    [ \"$hour\" -gt 23 ] 2>/dev/null && continue\n    [ \"$minute\" -gt 59 ] 2>/dev/null && continue\n\n    target=$(( (day - 1) * 86400 + hour * 3600 + minute * 60 ))\n    delta=$(( target - now ))\n\n    # Если минута уже началась, эта недельная точка считается прошедшей.\n    [ \"$delta\" -le 0 ] && delta=$((delta + 604800))\n\n    if [ \"$delta\" -lt \"$best\" ]; then\n        best=$delta\n        best_event=$event\n    fi\ndone <<MD_ITEMS\n$items\nMD_ITEMS\n\nif [ -z \"$best_event\" ]; then\n    best=604800\n    best_event=\"__NONE__\"\n    next_epoch=0\nelse\n    next_epoch=$((epoch + best))\nfi\n\n# delay ### event ### absolute Unix time\nprintf '%s###MD###%s###MD###%s' \"$best\" \"$best_event\" \"$next_epoch\"","m_variableToSaveResponse":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"delay_text","m_stringValue":"","m_type":2,"supportsInput":false,"supportsOutput":true},"timeoutSeconds":5,"useHelper":false,"useShizuku":false,"disableLogging":false,"m_SIGUID":-3471025363174439741,"m_classType":"ShellScriptActi