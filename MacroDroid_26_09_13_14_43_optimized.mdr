e,"disableLogging":false,"m_SIGUID":-999880643733697066,"m_classType":"LoopAction","m_comment":"Цикл редактора. В начале каждой итерации сначала обновляется лёгкий счётчик, затем открывается главное меню.","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_nonRoot":true,"m_script":"target={v=Следующее событие Unix}\nnow={system_time}\n\n# Планировщик хранит готовое абсолютное время. Здесь расписание вообще не читается.\ncase \"$target\" in\n    ''|*[!0-9-]*) printf 'Время следующего события ещё не рассчитано'; exit ;;\nesac\n\nif [ \"$target\" -le 0 ] 2>/dev/null; then\n    printf 'Расписание пусто'\n    exit\nfi\n\ndelta=$((target - now))\n[ \"$delta\" -lt 0 ] && delta=0\n\ndays_left=$((delta / 86400))\nhours=$(((delta % 86400) / 3600))\nminutes=$(((delta % 3600) / 60))\nseconds=$((delta % 60))\ntext=''\n\nru_part() {\n    n=$1\n    one=$2\n    few=$3\n    many=$4\n    n100=$((n % 100))\n    n10=$((n % 10))\n\n    if [ \"$n100\" -ge 11 ] && [ \"$n100\" -le 14 ]; then\n        word=$many\n    elif [ \"$n10\" -eq 1 ]; then\n        word=$one\n    elif [ \"$n10\" -ge 2 ] && [ \"$n10\" -le 4 ]; then\n        word=$few\n    else\n        word=$many\n    fi\n    printf '%s %s' \"$n\" \"$word\"\n}\n\nappend_part() {\n    part=$1\n    [ -n \"$text\" ] && text=\"$text \"\n    text=\"${text}${part}\"\n}\n\n[ \"$days_left\" -gt 0 ] && append_part \"$(ru_part \"$days_left\" 'день' 'дня' 'дней')\"\n[ \"$hours\" -gt 0 ] && append_part \"$(ru_part \"$hours\" 'час' 'часа' 'часов')\"\n[ \"$minutes\" -gt 0 ] && append_part \"$(ru_part \"$minutes\" 'минута' 'минуты' 'минут')\"\nappend_part \"$(ru_part \"$seconds\" 'секунда' 'секунды' 'секунд')\"\n\nprintf 'До следующего события: %s' \"$text\"","m_variableToSaveResponse":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"next_countdown","m_stringValue":"","m_type":2,"supportsInput":false,"supportsOutput":true},"timeoutSeconds":5,"useHelper":false,"useShizuku":false,"disableLogging":false,"m_SIGUID":738219447120063519,"m_classType":"ShellScriptAction","m_comment":"Лёгкий пересчёт остатка прямо внутри цикла, непосредственно перед КАЖДЫМ показом главного меню. Расписание не перебирается.","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"bgColor":-13619152,"buttonStyle":0,"continueMacroOnBackPress":false,"customEntries":[],"defaultButtonIndex":0,"defaultKey":"","defaultTimeOutSecs":30,"dictionaryKeys":{"keys":[]},"dictionaryVarName":"Меню","hasDefault":false,"message":"Редактор расписания UTC\n\n{lv=next_countdown}","option":1,"preventBackButtonClose":false,"saveIndexVariable":{"variableName":"menu_index","keys":{"keys":[]}},"showDictionaryKeys":false,"textColor":-1118482,"titleAlignment":0,"disableLogging":false,"m_SIGUID":-5604515653566805869,"m_classType":"SelectionDialogAction","m_comment":"Главное меню. next_countdown пересчитан предыдущим действием в этой же итерации цикла.","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"bgColor":-13619152,"buttonStyle":0,"continueMacroOnBackPress":false,"customEntries":[],"defaultButtonIndex":0,"defaultKey":"","defaultTimeOutSecs":30,"dictionaryKeys":{"keys":[]},"dictionaryVarName":"Режим показа","hasDefault":false,"message":"Показать расписание","option":1,"preventBackButtonClose":false,"saveIndexVariable":{"variableName":"show_time_mode_index","keys":{"keys":[]}},"showDictionaryKeys":false,"textColor":-1118482,"titleAlignment":0,"disableLogging":false,"m_SIGUID":-3350309854060193140,"m_classType":"SelectionDialogAction","m_comment":"","m_constraintList":[{"checkCase":false,"dictionaryKeys":{"keys":[]},"dictionaryType":1,"enableRegex":false,"m_booleanValue":false,"m_doubleValue":0.0,"m_intCompareVariable":false,"m_intGreaterThan":false,"m_intLessThan":false,"m_intNotEqual":false,"m_intValue":0,"m_stringComparisonType":0,"m_stringEqual":true,"m_stringValue":"","m_variable":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"menu_index","m_stringValue":"","m_type":1,"supportsInput":true,"supportsOutput":true},"disableLogging":false,"m_SIGUID":1035372585639758075,"m_classType":"MacroDroidVariableConstraint","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_isDisabled":false,"m_isOrCondition":false},{"cancelPrevious":true,"m_backgroundColor":-14606047,"m_displayIcon":false,"m_duration":0,"m_horizontalPosition":0,"m_imageName":"launcher_no_border","m_imagePackageName":"com.arlosoft.macrodroid","m_imageResourceName":"launcher_no_border","m_messageText":"Пересчитываю расписание…","m_position":0,"m_textColor":-1,"m_tintIcon":false,"maintainSpaces":false,"textAlignment":0,"useTextOnly":true,"disableLogging":false,"m_SIGUID":-8283987578065358831,"m_classType":"ToastAction","m_comment":"Показывается сразу после выбора «Местное время», чтобы было понятно, что идёт пересчёт.","m_constraintList":[{"checkCase":false,"dictionaryKeys":{"keys":[]},"dictionaryType":1,"enableRegex":false,"m_booleanValue":false,"m_doubleValue":0.0,"m_intCompareVariable":false,"m_intGreaterThan":false,"m_intLessThan":false,"m_intNotEqual":false,"m_intValue":0,"m_stringComparisonType":0,"m_stringEqual":true,"m_stringValue":"","m_variable":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"menu_index","m_stringValue":"","m_type":1,"supportsInput":true,"supportsOutput":true},"disableLogging":false,"m_SIGUID":4378303751962976383,"m_classType":"MacroDroidVariableConstraint","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"checkCase":false,"dictionaryKeys":{"keys":[]},"dictionaryType":1,"enableRegex":false,"m_booleanValue":false,"m_doubleValue":0.0,"m_intCompareVariable":false,"m_intGreaterThan":false,"m_intLessThan":false,"m_intNotEqual":false,"m_intValue":1,"m_stringComparisonType":0,"m_stringEqual":true,"m_stringValue":"","m_variable":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"show_time_mode_index","m_stringValue":"","m_type":1,"supportsInput":true,"supportsOutput":true},"disableLogging":false,"m_SIGUID":-1861384215156536382,"m_classType":"MacroDroidVariableConstraint","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_nonRoot":true,"m_script":"j=$(cat <<'MDJSON'\n{vjson=Расписание}\nMDJSON\n)\nmode={lv=show_time_mode_index}\n\n# Берём только реальные записи вида: D HH:MM|Событие.\nitems=$(printf '%s' \"$j\" | grep -oE '\"[1-7] [0-2][0-9]:[0-5][0-9]\\|[^\\\"]+\"' | sed 's/^\"//;s/\"$//')\n\nformat_utc() {\n    printf '%s\\n' \"$items\" | \\\n    sed -E 's/^([1-7]) ([0-9]{2}:[0-9]{2})\\|(.*)$/\\1 \\2 | \\3/' | \\\n    sort -k1,1n -k2,2 | \\\n    sed -E 's/^1 /Пн /;s/^2 /Вт /;s/^3 /Ср /;s/^4 /Чт /;s/^5 /Пт /;s/^6 /Сб /;s/^7 /Вс /'\n}\n\nif [ \"$mode\" -eq 0 ] 2>/dev/null; then\n    format_utc\n    exit\nfi\n\nz=$(date +%z 2>/dev/null | tr -d '\\r\\n:')\noff=''\ncase \"$z\" in\n    +[0-9][0-9][0-9][0-9]|-[0-9][0-9][0-9][0-9])\n        sign=$(printf '%s' \"$z\" | cut -c1)\n        oh=$(printf '%s' \"$z\" | cut -c2-3)\n        om=$(printf '%s' \"$z\" | cut -c4-5)\n        oh=${oh#0}; om=${om#0}\n        [ -z \"$oh\" ] && oh=0\n        [ -z \"$om\" ] && om=0\n        off=$((oh * 60 + om))\n        [ \"$sign\" = '-' ] && off=$((-off))\n        ;;\nesac\n\nif [ -z \"$off\" ]; then\n    uw=$(date -u +%w 2>/dev/null)\n    uh=$(date -u +%H 2>/dev/null)\n    um=$(date -u +%M 2>/dev/null)\n    lw=$(date +%w 2>/dev/null)\n    lh=$(date +%H 2>/dev/null)\n    lm=$(date +%M 2>/dev/null)\n\n    case \"$uw$uh$um$lw$lh$lm\" in\n        *[!0-9]*) off=0 ;;\n        *)\n            uh=${uh#0}; um=${um#0}; lh=${lh#0}; lm=${lm#0}\n            [ -z \"$uh\" ] && uh=0; [ -z \"$um\" ] && um=0\n            [ -z \"$lh\" ] && lh=0; [ -z \"$lm\" ] && lm=0\n            ud=$(((uw + 6) % 7 + 1))\n            ld=$(((lw + 6) % 7 + 1))\n            utc_now=$(((ud - 1) * 1440 + uh * 60 + um))\n            local_now=$(((ld - 1) * 1440 + lh * 60 + lm))\n            off=$((local_now - utc_now))\n            [ \"$off\" -gt 5040 ] && off=$((off - 10080))\n            [ \"$off\" -lt -5040 ] && off=$((off + 10080))\n            ;;\n    esac\nfi\n\nprintf '%s\\n' \"$items\" | awk -v off=\"$off\" '\n{\n    separator = index($0, \"|\")\n    if (separator == 0) next\n\n    key = substr($0, 1, separator - 1)\n    event = substr($0, separator + 1)\n    split(key, key_parts, \" \")\n    split(key_parts[2], time_parts, \":\")\n\n    day = key_parts[1] + 0\n    hour = time_parts[1] + 0\n    minute = time_parts[2] + 0\n    if (day < 1 || day > 7 || hour < 0 || hour > 23 || minute < 0 || minute > 59) next\n\n    total = (day - 1) * 1440 + hour * 60 + minute + off\n    while (total < 0) total += 10080\n    total %= 10080\n\n    output_day = int(total / 1440) + 1\n    remainder = total % 1440\n    output_hour = int(remainder / 60)\n    output_minute = remainder % 60\n    print sprintf(\"%d %02d:%02d | %s\", output_day, output_hour, output_minute, event)\n}' | sort -k1,1n -k2,2 | \\\nsed -E 's/^1 /Пн /;s/^2 /Вт /;s/^3 /Ср /;s/^4 /Чт /;s/^5 /Пт /;s/^6 /Сб /;s/^7 /Вс /'","m_variableToSaveResponse":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"show_tex