207425,"m_classType":"MacroDroidVariableConstraint","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"checkCase":true,"dictionaryKeys":{"keys":[]},"dictionaryType":2,"enableRegex":false,"m_booleanValue":false,"m_doubleValue":0.0,"m_intCompareVariable":false,"m_intGreaterThan":false,"m_intLessThan":false,"m_intNotEqual":false,"m_intValue":0,"m_stringComparisonType":0,"m_stringEqual":false,"m_stringValue":"INVALID","m_variable":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"schedule_key","m_stringValue":"","m_type":2,"supportsInput":true,"supportsOutput":true},"disableLogging":false,"m_SIGUID":6873835965854039968,"m_classType":"MacroDroidVariableConstraint","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false}],"m_isDisabled":false,"m_isOrCondition":false},{"blockNextAction":true,"m_nonRoot":true,"m_script":"schedule_json=$(cat <<'MD_SCHEDULE_JSON'\n{vjson=Расписание}\nMD_SCHEDULE_JSON\n)\n\n# Синхронно обновляем только кэш ближайшего события после изменения расписания.\n# Та же недельная UTC-логика, что и в «Планировщик UTC», но без ожидания события.\nepoch={system_time}\ndays=$((epoch / 86400))\nsec_day=$((epoch % 86400))\nnow_day=$(( (days + 3) % 7 + 1 ))\nnow=$(( (now_day - 1) * 86400 + sec_day ))\n\nbest=604801\nfound=0\nitems=$(printf '%s' \"$schedule_json\" | grep -oE '\"[1-7] [0-2][0-9]:[0-5][0-9]\\|[^\\\"]+\"' | sed 's/^\"//;s/\"$//')\n\nwhile IFS= read -r item; do\n    [ -z \"$item\" ] && continue\n    day=$(printf '%s' \"$item\" | cut -d ' ' -f1)\n    rest=$(printf '%s' \"$item\" | cut -d ' ' -f2-)\n    time=$(printf '%s' \"$rest\" | cut -d '|' -f1)\n    hour=$(printf '%s' \"$time\" | cut -d ':' -f1)\n    minute=$(printf '%s' \"$time\" | cut -d ':' -f2)\n    hour=${hour#0}; minute=${minute#0}\n    [ -z \"$hour\" ] && hour=0\n    [ -z \"$minute\" ] && minute=0\n\n    case \"$day\" in 1|2|3|4|5|6|7) ;; *) continue ;; esac\n    case \"$hour$minute\" in *[!0-9]*) continue ;; esac\n\n    target=$(( (day - 1) * 86400 + hour * 3600 + minute * 60 ))\n    delta=$((target - now))\n    [ \"$delta\" -le 0 ] && delta=$((delta + 604800))\n\n    if [ \"$delta\" -lt \"$best\" ]; then\n        best=$delta\n        found=1\n    fi\ndone <<MD_ITEMS\n$items\nMD_ITEMS\n\nif [ \"$found\" -eq 0 ]; then\n    printf '0'\nelse\n    printf '%s' $((epoch + best))\nfi","m_variableToSaveResponse":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"next_epoch_refresh","m_stringValue":"","m_type":2,"supportsInput":false,"supportsOutput":true},"timeoutSeconds":5,"useHelper":false,"useShizuku":false,"disableLogging":false,"m_SIGUID":-5186611643151808267,"m_classType":"ShellScriptAction","m_comment":"После изменения расписания синхронно ищет ближайшее событие Android-совместимым разбором через cut. Результат — Unix-время строкой.","m_constraintList":[{"checkCase":false,"dictionaryKeys":{"keys":[]},"dictionaryType":1,"enableRegex":false,"m_booleanValue":false,"m_doubleValue":0.0,"m_intCompareVariable":false,"m_intGreaterThan":false,"m_intLessThan":false,"m_intNotEqual":false,"m_intValue":1,"m_stringComparisonType":0,"m_stringEqual":true,"m_stringValue":"","m_variable":{"dictionary":{"entries":[],"isArray":false,"variableType":4,"type":"Dictionary"},"isActionBlockWorkingVar":false,"isLocalVar":true,"isSecure":false,"m_booleanValue":false,"m_decimalValue":0.0,"m_intValue":0,"m_name":"menu_index","m_stringValue":"","m_type":1,"supportsInput":true,"supportsOutput":true},"disableLogging":false,"m_SIGUID":-4149137992722207425,"m_classType":"MacroDroidVariableConstraint","m_comment":"","m_constraintList":[],"m_isDisabled":false,"m_isOrCondition":false},{"checkCase":t